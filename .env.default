# Runtime environment. Only read from the real process environment (not from this file):
# start_dev.sh leaves it unset (-> "dev", reads .env), start_prod.sh sets APP_ENV=prod (reads .env.prod).

# Shared secret the bots send in the X-API-Key header. Required.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Database (SQLite by default; the file is created on first start)
DATABASE_URL=sqlite:///./tox.db

# Seconds a trivia question stays open before it expires
TRIVIA_TIMEOUT_SECONDS=60

# Comma-separated command prefixes
COMMAND_PREFIXES=!,/

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Admins: comma-separated "platform:user_id" (send !id in a chat to see yours), e.g.
# ADMIN_USER_IDS=whatsapp:111111111111111@lid,telegram:123456789
ADMIN_USER_IDS=

# Sound clips for !m (.m4a, .mp3, .ogg, .opus, .aac; max 16 MB each). New files are picked up without restarting.
# If the folder is missing or empty, !m always tags someone instead.
AUDIOS_DIR=media/m
# Chance (0 to 1) that !m sends a random audio instead of tagging someone
M_AUDIO_PROBABILITY=0.5

# How long (seconds) generated media (!sticker images, !decir audio) is kept in memory for the bot to download
MEDIA_CACHE_SECONDS=120
# Wall-clock ceiling (seconds) for one !decir call (network TTS + ffmpeg conversion)
TTS_TIMEOUT_SECONDS=20

# Admin-only !service: shows whether your hosted services are up. Create an API key in your hosting provider's
# dashboard and paste it in .env / .env.prod only. Empty = the command says it isn't configured.
RENDER_API_KEY=
RENDER_API_TIMEOUT_SECONDS=4

# Admin-only `!service -L`: JSON allowlist of LOCAL services (this PC) the admins may start/stop/query.
# Only what is listed there can ever run; the chat just picks a name. See services.example.json.
SERVICES_FILE=services.json
# Max seconds a start/stop/status command may run. Keep it below the bots' TOX_API_TIMEOUT_MS.
SERVICE_COMMAND_TIMEOUT_SECONDS=8

# `!service -L pc` (admin only) reports the health of this PC. Failed systemd units listed here (comma-separated,
# e.g. some-leftover.service) are not counted as a problem.
HOST_IGNORED_UNITS=

# The API samples this machine (CPU, memory, temperature, battery) every N seconds (0 = off) so that
# `!service -L host` can show peaks and battery trends. Older samples than HOST_HISTORY_DAYS are deleted.
HOST_SAMPLE_INTERVAL_SECONDS=60
HOST_HISTORY_DAYS=7

# `!github` (admin only): PRs (default) or issues of these repos. Comma-separated "owner/name" or GitHub URLs.
GITHUB_REPOS=
# Read-only token, needed for private repos (public ones work without, at 60 requests/hour). Create a fine-grained
# token with read access to Pull requests, Issues and Metadata, and paste it here. Never in a chat.
GITHUB_TOKEN=
# Alternative to GITHUB_TOKEN: use the session of the GitHub CLI (`gh auth login`). Its token usually has broad scopes.
GITHUB_TOKEN_FROM_GH=false
GITHUB_TIMEOUT_SECONDS=5

