# Runtime environment. Only read from the real process environment (not from this file):
# start_dev.sh leaves it unset (-> "dev", reads .env), start_prod.sh sets APP_ENV=prod (reads .env.prod).

# Shared secret the bots send in the X-API-Key header. Required.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Database (SQLite by default; the file is created on first start)
DATABASE_URL=sqlite:///./tox.db

# Seconds a trivia question stays open before it expires
TRIVIA_TIMEOUT_SECONDS=30

# Comma-separated command prefixes
COMMAND_PREFIXES=!,/

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Folder for the log files, next to the console output (empty = console only). One file every
# LOG_ROTATE_HOURS: `tox.log` is the current one, the older ones are `tox-2026-10-20.log`. They are never
# deleted on their own, so clear out the old ones by hand once in a while.
LOG_DIR=logs
LOG_ROTATE_HOURS=24

# Admins: comma-separated "platform:user_id" (send !id in a chat to see yours), e.g.
# ADMIN_USER_IDS=whatsapp:111111111111111@lid,telegram:123456789
ADMIN_USER_IDS=
# The owner(s): admins in EVERY chat, including a group they don't administer in WhatsApp (everybody on the list
# above is an admin only where the platform says they administer that group). Same shape, comma separated. Being
# here is enough; there is no need to be on ADMIN_USER_IDS too. Still never an admin from the personal mode.
OWNER_USER_IDS=

# Sound clips for !m (.m4a, .mp3, .ogg, .opus, .aac; max 16 MB each). New files are picked up without restarting.
# If the folder is missing or empty, !m always tags someone instead.
AUDIOS_DIR=media/m
# Chance (0 to 1) that !m sends a random audio instead of tagging someone
M_AUDIO_PROBABILITY=0.5

# Sound clips for !risa (same formats/limits as AUDIOS_DIR). If missing or empty, !risa says it has nothing to send.
RISA_AUDIOS_DIR=media/risa

# How long (seconds) generated media (!sticker images, !decir audio) is kept in memory for the bot to download
MEDIA_CACHE_SECONDS=120

# `!yt <link>` (video) and `!ytm <link>` (audio) of YouTube, with yt-dlp and ffmpeg. The duration is checked before
# anything is downloaded; the size decides the quality, which is stepped down until it fits (16 MB is what WhatsApp
# takes, and eight minutes at 360p is about 24 MB). Nothing is kept on this machine: the download is written to
# YT_WORK_DIR for the moment it takes to read it, and `/dev/shm` is RAM, so the disk is never touched
# ("" = the system's temp folder). FFMPEG_PATH only if ffmpeg is somewhere yt-dlp will not find on its own.
YT_MAX_DURATION_SECONDS=480
YT_MAX_BYTES=16000000
YT_TIMEOUT_SECONDS=180
YT_WORK_DIR=/dev/shm
FFMPEG_PATH=
# Pictures for the GTA VI countdown card (!vi): one of this folder at random on each card. media/ is not tracked,
# so they stay on this machine; Rockstar hands them out as wallpapers on rockstargames.com/VI. Empty folder = the
# card draws its own Vice City sunset instead.
GTA_ARTWORK_DIR=media/gta6
# The picture of the card sent the day it comes out: always this one, never a random screenshot
GTA_COVER_FILE=media/gta6/cover.jpg
# The same countdown as an Instagram story. Needs a professional BUSINESS account (a creator one cannot publish
# stories), a token from Instagram > API setup with Instagram login (60 days), and an imgbb key: Instagram downloads
# the picture from a public URL instead of receiving it, so it is parked there and deleted again right after.
INSTAGRAM_ENABLED=false
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
IMGBB_API_KEY=
INSTAGRAM_TIMEOUT_SECONDS=30
INSTAGRAM_IMAGE_TTL_SECONDS=600
# Wall-clock ceiling (seconds) for one !decir call (network TTS + ffmpeg conversion)
TTS_TIMEOUT_SECONDS=20

# Admin-only !service: shows whether your hosted services are up. Create an API key in your hosting provider's
# dashboard and paste it in .env / .env.prod only. Empty = the command says it isn't configured.
RENDER_API_KEY=
RENDER_API_TIMEOUT_SECONDS=4

# Admin-only `!service -L`: JSON allowlist of LOCAL services (this PC) the admins may start/stop/query.
# Only what is listed there can ever run; the chat just picks a name. See services.example.json.
SERVICES_FILE=services.json
# Local directory of who is who (name -> platform ids), to give certain people special behaviour in some commands.
# Built from `!uid`'s output; git-ignored like services.json. See users.example.json.
USERS_FILE=users.json
# Names for the devices `!ip` finds, by MAC: {"5a:11:22:33:44:66": "Celular de Ana"}. Git-ignored. See devices.example.json.
DEVICES_FILE=devices.json

# Admin-only `!web`: opens an app of this PC in an invisible browser and lets you drive it from the chat with numbered
# screenshots. The apps it may open (and their login, kept out of git) are listed in WEB_APPS_FILE; see webapps.example.json.
WEB_APPS_FILE=webapps.json
# Seconds without use before the browser closes by itself (it takes ~450 MB of RAM while open)
WEB_IDLE_SECONDS=180
# Seconds `!web` waits before each screenshot, for the page to finish loading its data
WEB_SCREENSHOT_DELAY_SECONDS=3
# Max seconds a start/stop/status command may run. Keep it below the bots' TOX_API_TIMEOUT_MS.
SERVICE_COMMAND_TIMEOUT_SECONDS=8

# `!service -L pc` (admin only) reports the health of this PC. Failed systemd units listed here (comma-separated,
# e.g. some-leftover.service) are not counted as a problem.
HOST_IGNORED_UNITS=

# The API samples this machine (CPU, memory, temperature, battery) every N seconds (0 = off) so that
# `!service -L host` can show peaks and battery trends. Older samples than HOST_HISTORY_DAYS are deleted.
HOST_SAMPLE_INTERVAL_SECONDS=60
HOST_HISTORY_DAYS=7

# `!github` (admin only): PRs (default) or issues of these repos. Comma-separated "owner/name" or GitHub URLs.
GITHUB_REPOS=
# Read-only token, needed for private repos (public ones work without, at 60 requests/hour). Create a fine-grained
# token with read access to Pull requests, Issues and Metadata, and paste it here. Never in a chat.
GITHUB_TOKEN=
# Alternative to GITHUB_TOKEN: use the session of the GitHub CLI (`gh auth login`). Its token usually has broad scopes.
GITHUB_TOKEN_FROM_GH=false
GITHUB_TIMEOUT_SECONDS=5

# `!futbol` (público): fixtures (default) o tabla (-t) de la liga top de Uruguay, Ecuador,
# Argentina o España, vía la API pública (no oficial) de ESPN. No hace falta ninguna key.
# Segundos antes de que un pedido a ESPN expire
FOOTBALL_TIMEOUT_SECONDS=6
# Cuánto (segundos) se cachean fixtures/tabla antes de volver a pedirlos (24 h por defecto)
FOOTBALL_CACHE_TTL_SECONDS=86400

# Proactive alerts: a background check, every ALERT_CHECK_INTERVAL_SECONDS, on the local services listed here
# (comma-separated names from SERVICES_FILE). Empty = off. A service going down, or recovering, sends exactly
# one message per change (not one per check) to every chat below.
ALERT_SERVICES=
ALERT_CHECK_INTERVAL_SECONDS=300
# Comma-separated WhatsApp group JIDs / Telegram chat ids to notify, e.g.
# ALERT_WHATSAPP_GROUP_JIDS=1234567890-1234567890@g.us
# ALERT_TELEGRAM_CHAT_IDS=-1001234567890
ALERT_WHATSAPP_GROUP_JIDS=
ALERT_TELEGRAM_CHAT_IDS=

# Time zone of the clock times people type in `!recordar 18:30 ...` (IANA name)
TIMEZONE=America/Montevideo

# `!claude`: runs the Claude Code CLI (`claude -p`). Admins get FULL access (it can edit files and run commands) in
# CLAUDE_WORKDIR; everybody else gets a plain chat with no access to this PC. Empty CLAUDE_BIN = find `claude` in PATH.
CLAUDE_WORKDIR=~/dev
CLAUDE_BIN=
# Most one question may spend (USD), questions allowed per hour (all admins together), and seconds before it is cut off
CLAUDE_MAX_BUDGET_USD=2.5
CLAUDE_QUESTIONS_PER_HOUR=200
CLAUDE_TIMEOUT_SECONDS=600
# Questions answered at once for non-admins and summaries (the admins' go one by one), and how many more may wait their
# turn before the answer is "too many queries" (0 = no waiting line)
# Share of `claude` answers sent as a voice note instead of text (0 = never, 1 = always), and the voice used
CLAUDE_AUDIO_CHANCE=0.25
CLAUDE_AUDIO_VOICE=hombre
# How Tox talks: salado (insults and swearing among friends), picante (sarcastic and chicanero), tranqui (playful
# and joking, but it teases nobody) or normal (nothing added). The default of every chat: one chat can be given its
# own with !config tono <cual>, which is what a group where not everybody is in on the joke wants.
CLAUDE_TONE=salado
CLAUDE_PARALLEL=2
CLAUDE_QUEUE_MAX=5
# The answer sent to the chat is asked to fit, and is cut to, this many characters
CLAUDE_MAX_ANSWER_CHARS=800
# Non-admins: most one question may spend (USD), questions allowed per hour (all of them together) and per person
CLAUDE_PUBLIC_MAX_BUDGET_USD=0.10
CLAUDE_PUBLIC_QUESTIONS_PER_HOUR=100
CLAUDE_PUBLIC_QUESTIONS_PER_PERSON_PER_HOUR=100
# true: replying to a message of the bot asks Claude, without writing !claude / !c (the reply is the question)
CLAUDE_ON_REPLY=true
# Share of the messages of a group (with history on) after which Tox butts in by itself with one remark, always as
# text (0 = never), and the minutes it stays quiet in that chat afterwards (answering a question counts too).
# This and the other settings of how talkative Tox is (CLAUDE_ON_REPLY, CLAUDE_PROFILE_PEOPLE_CHANCE,
# CLAUDE_AUDIO_CHANCE, CLAUDE_CONTEXT_MESSAGES, CLAUDE_CONTEXT_HOURS) are the default for every chat: an admin can
# give one chat its own value from the chat itself with !config, and that one is kept in the database.
CLAUDE_INTERJECT_CHANCE=0.02
CLAUDE_INTERJECT_COOLDOWN_MINUTES=30
# How often Tox is told what the owner wrote about each member (chats.json's "people") when nobody typed a
# command (a remark of its own, an answer to a reply): with it at hand every message turns into the same joke
# about somebody's job or city. What the chat is about always goes, and a typed !claude always gets it all.
CLAUDE_PROFILE_PEOPLE_CHANCE=0.25
# Non-admins, in chats with the history on (!h -on): how many of the latest messages (0 = none) and how many hours back
# go to Claude along with the question, so it knows what was being talked about
CLAUDE_CONTEXT_MESSAGES=150
# ... and the most characters of them (the oldest messages are dropped first)
CLAUDE_CONTEXT_MAX_CHARS=20000
CLAUDE_CONTEXT_HOURS=12
# A chat can also be told what was said in ANOTHER one (set up with !spy): how many of its latest messages go and
# how much room they get. Only when the question names that source, so most answers never see them; the hours above
# bound how far back they are read. 0 messages = the feature is off everywhere.
CLAUDE_SOURCE_MESSAGES=50
CLAUDE_SOURCE_MAX_CHARS=6000

# --- Chat history (`!historial`, `!resumen`; only from the owner's personal bot) ---
# The text of the chats it was turned on for, in a SQLite file of its own (git-ignored, mode 600). Once it passes
# HISTORY_MAX_MB the oldest messages are deleted.
HISTORY_DB_PATH=history.sqlite
HISTORY_MAX_MB=1024
# Most messages one `!resumen` reads, and the longest summary it sends
HISTORY_SUMMARY_MAX_MESSAGES=500
HISTORY_SUMMARY_MAX_CHARS=1500
# Money cap (US$) of one summary
CLAUDE_SUMMARY_MAX_BUDGET_USD=0.5
