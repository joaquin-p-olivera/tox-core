__pycache__/
*.pyc
*.pyo
.pytest_cache/

.venv/

# Environment files: only the .env.default template is tracked
.env
.env.*
!.env.default

# Local SQLite database
*.db
# Saved chat text (!historial): private conversations, never tracked
*.sqlite
*.sqlite-journal
*.db-journal
*.db-wal
*.db-shm

# Downloaded media (e.g. media/m: the sound clips for !m) is local content: never tracked
media/

# Which commands the bot may run on this machine is local configuration (only the example is tracked)
services.json


# Who is who (platform ids, phone numbers) is local data about real people (only the example is tracked)
users.json

# What each chat is about and who its people are, for !claude's context (only the example is tracked)
chats.json

# MAC -> name of the devices on the home network (only the example is tracked)
devices.json

# Apps the remote browser may open, with their login (only the example is tracked)
webapps.json

# Local joke list (!chiste): kept out of the repo on purpose
app/data/jokes.json
